    "models-autoload": {
      "value": "none",
      "category": "router",
      "description": "Allow the router to load models on demand."
    },
    "no-models-autoload": {
      "value": "none",
      "category": "router",
      "description": "Disable router model autoloading."
    },
    "sleep-idle-seconds": {
      "value": "int",
      "category": "router",
      "description": "Seconds of inactivity before a router model sleeps."
    },
    "fit-target": {
      "value": "int",
      "category": "router",
      "description": "Memory target in MiB used by router auto-fit."
    },
    "models-memory-margin": {
      "value": "int",
      "category": "router",
      "description": "Memory margin in MiB reserved by the router."
    },
    "log-file": {
      "value": "path",
      "category": "logging",
      "description": "Write server logs to this file."
    },
    "verbose": {
      "value": "none",
      "category": "logging",
      "description": "Enable verbose logging."
