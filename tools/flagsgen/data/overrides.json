      "category": "offload",
      "description": "Alias for --gpu-layers."
    },
    "n-cpu-moe": {
      "value": "int",
      "category": "offload",
      "description": "Number of MoE expert layers to keep in system RAM."
    },
    "threads": {
      "value": "int",
      "category": "performance",
      "description": "Threads used for token generation."
    },
