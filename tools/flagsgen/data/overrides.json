  },
  "overrides": {
    "help": {
      "value": "none",
      "category": "general",
      "description": "Show llama-server help and exit."
    },
    "version": {
      "value": "none",
      "category": "general",
      "description": "Show llama-server version and build information and exit."
    },
    "model": {
      "value": "path",
      "category": "model",
      "description": "Path to the GGUF model file."
    },
    "model-alias": {
      "value": "string",
      "category": "model",
      "deprecated": true,
      "replacement": "--alias",
      "description": "Deprecated alias for --alias."
    },
    "alias": {
      "value": "string",
      "category": "model",
      "description": "Friendly name reported for the loaded model."
    },
    "ctx-size": {
      "value": "int",
